{
  "name": "pgdeadbolt",
  "version": "0.0.0",
  "description": "Stop AI coding agents from shipping Postgres migrations that lock your tables.",
  "keywords": [
    "postgres",
    "postgresql",
    "migrations",
    "zero-downtime",
    "locks",
    "linter",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor"
  ],
  "homepage": "https://pgdeadbolt.aryantah.com",
  "bugs": "https://github.com/aryan-tah/pgdeadbolt/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryan-tah/pgdeadbolt.git"
  },
  "license": "MIT",
  "author": "Aryan Tah (https://aryantah.com)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.15.21",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
