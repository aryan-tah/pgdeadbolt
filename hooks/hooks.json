{
  "description": "Check every Postgres migration Claude writes for statements that lock tables.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-migration.mjs\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
